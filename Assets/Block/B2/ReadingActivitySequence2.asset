  items:
  - bodyText: "\u306A\u304C\u3044 <u>\u3078\u3073</u>\u304C \u3044\u308B\u3002\r\n<u>\u3078\u3073</u>\u306F
      \u3057\u308D\u3044!"
    correctItemId: Serpiente
    narrationClip: {fileID: 8300000, guid: 022395baeda1d0744b7894c05cc2d7df, type: 3}
  - bodyText: "\u3088\u308B\u3001<u>\u307B\u305F\u308B</u>\u304C \u3072\u304B\u308B\u3002\r\n\u3061\u3044\u3055\u3044
      <u>\u307B\u305F\u308B</u>\u3002"
    correctItemId: Luciernaga
    narrationClip: {fileID: 8300000, guid: 328689fd66421b440b5850077db1989f, type: 3}
  - bodyText: "\u307F\u305A\u306E \u306A\u304B\u306B <u>\u3081\u3060\u304B</u>\u304C
      \u304A\u3088\u3050\u3002\r\n\u3061\u3044\u3055\u3044 <u>\u3081\u3060\u304B</u>\u3002"
    correctItemId: Medaka
    narrationClip: {fileID: 8300000, guid: b97cd1b520ccf274fb9683481d84d142, type: 3}
  - bodyText: "\u3042\u3081\u306E \u3072\u306B <u>\u307F\u306E</u>\u3092 \u304D\u308B\u3002\r\n\u3075\u308B\u3044
      <u>\u307F\u306E</u>\u3002"
    correctItemId: Capa
    narrationClip: {fileID: 8300000, guid: 781e834f6933b2740965064fc2427306, type: 3}
  - bodyText: "\u3042\u305F\u307E\u306B <u>\u307C\u3046\u3057</u>\u3092 \u304B\u3076\u308B\u3002\r\n\u3042\u304B\u3044
      <u>\u307C\u3046\u3057</u>!"
