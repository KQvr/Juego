  items:
  - bodyText: "\u3042\u304B\u3044 \u304A\u306B\u3068 \u3042\u304A\u3044 <u>\u304A\u306B</u>\u304C
      \u3044\u308B\u3002\r\n<u>\u304A\u306B</u>\u3068 \u3042\u305D\u3076\u3088!"
    correctItemId: DemJP
    narrationClip: {fileID: 8300000, guid: 23cdc0bc32fa2c140865fd1909312788, type: 3}
  - bodyText: "\u305D\u3089\u3092 <u>\u3053\u3044\u306E\u307C\u308A</u>\u304C \u304A\u3088\u3050\u3002\r\n\u304A\u304A\u304D\u3044
      <u>\u3053\u3044\u306E\u307C\u308A</u>!"
