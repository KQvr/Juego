    narrationClip: {fileID: 8300000, guid: 56e046cbcd65afa4b9ee9caa3badc007, type: 3}
  - bodyText: "\u3042\u3055\u306F <u>\u305F\u307E\u3054</u>\u3092 \u305F\u3079\u308B\u3002\r\n\u3061\u3044\u3055\u3044
      \u3068\u308A\u306E <u>\u305F\u307E\u3054</u>\u3002"
    correctItemId: Huevo
    narrationClip: {fileID: 8300000, guid: f76909ee75c0d104db7bd5dae2583ff1, type: 3}
  - bodyText: "\u3088\u308B\u3001\u304A\u304A\u304D\u3044 <u>\u3064\u304D</u>\u3092
      \u307F\u308B\u3002\r\n<u>\u3064\u304D</u>\u306F \u304D\u308C\u3044\u3060!"
    correctItemId: Luna
    narrationClip: {fileID: 8300000, guid: e7c3ad054779c684eafc9d790c933dab, type: 3}
  - bodyText: "\u3046\u307F\u306B <u>\u304B\u306B</u>\u304C \u3044\u308B\u3002\r\n\u3042\u304B\u3044
