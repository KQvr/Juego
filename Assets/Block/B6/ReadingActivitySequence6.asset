    narrationClip: {fileID: 8300000, guid: fd6769814cc19f84d905fe25f067086c, type: 3}
  - bodyText: "\u3064\u304F\u3048\u306B \u307F\u3058\u304B\u3044 <u>\u3048\u3093\u3074\u3064</u>\u3002\r\n\u3042\u304B\u3044
      <u>\u3048\u3093\u3074\u3064</u>\u3002"
    correctItemId: LapizC
    narrationClip: {fileID: 8300000, guid: 0ea163455946f384697c6b0b79522671, type: 3}
  - bodyText: "\u3042\u3055\u306F \u3042\u3064\u3044 <u>\u30B3\u30FC\u30D2\u30FC</u>\u3092
      \u306E\u3080\u3002\r\n\u304F\u308D\u3044 <u>\u30B3\u30FC\u30D2\u30FC</u>!"
    correctItemId: CafeC
    narrationClip: {fileID: 8300000, guid: fa9a0ad6dddebde41b3b9a5d5a8a2cf2, type: 3}
  - bodyText: "\u306A\u3064\u306B \u3064\u3081\u305F\u3044 <u>\u30A2\u30A4\u30B9</u>\u3092
      \u305F\u3079\u308B\u3002\r\n\u304A\u3044\u3057\u3044 <u>\u30A2\u30A4\u30B9</u>!"
