    narrationClip: {fileID: 8300000, guid: 62c8fabfdbd87554d8911489a5814675, type: 3}
  - bodyText: "\u306B\u308F\u306B \u306A\u304C\u3044 <u>\u3078\u3073</u>\u304C \u3044\u308B\u3002\r\n\u304F\u308D\u3044
