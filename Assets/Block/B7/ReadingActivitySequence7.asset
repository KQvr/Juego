    narrationClip: {fileID: 8300000, guid: 8425b26808eeae64cae898bb1e367106, type: 3}
  - bodyText: "\u306A\u3064\u306F <u>\u30D7\u30FC\u30EB</u>\u3067 \u304A\u3088\u3050\u3002\r\n\u3064\u3081\u305F\u3044
      <u>\u30D7\u30FC\u30EB</u>!"
    correctItemId: Piscina
    narrationClip: {fileID: 8300000, guid: c42039d1c4abad54c87c45823cb936f5, type: 3}
  - bodyText: "\u306A\u3064\u306F <u>\u3046\u307F</u>\u306B \u3044\u304F\u3002\r\n\u3042\u304A\u3044
