  items:
  - bodyText: "\u3042\u3055\u3001<u>\u3066\u3089</u>\u3078 \u3044\u304F\u3002\r\n\u3075\u308B\u3044
      <u>\u3066\u3089</u>!"
    correctItemId: Templo
    narrationClip: {fileID: 8300000, guid: 54e2f694f39b8684e81b756fb9fccc78, type: 3}
  - bodyText: "\u304A\u3057\u3087\u3046\u304C\u3064\u3001<u>\u3058\u3093\u3058\u3083</u>\u3078
      \u3044\u304F\u3002\r\n\u304A\u304A\u304D\u3044 <u>\u3058\u3093\u3058\u3083</u>\u3002"
    correctItemId: TemploS
    narrationClip: {fileID: 8300000, guid: d6b130c411497f94d9f1234e3dc55b33, type: 3}
  - bodyText: "\u305F\u304B\u3044 <u>\u30BF\u30EF\u30FC</u>\u3092 \u307F\u308B\u3002\r\n\u304A\u304A\u304D\u3044
      <u>\u30BF\u30EF\u30FC</u>!"
