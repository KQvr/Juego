    narrationClip: {fileID: 8300000, guid: e45c82363b2242046bf4b866568bfdf1, type: 3}
  - bodyText: "\u304A\u3072\u308B\u306F <u>\u3068\u3093\u304B\u3064</u>\u3092 \u305F\u3079\u308B\u3002\r\n\u304A\u3044\u3057\u3044
