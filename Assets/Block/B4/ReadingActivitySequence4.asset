    narrationClip: {fileID: 8300000, guid: 963432172c652da40839c19d20c417ec, type: 3}
  - bodyText: "\u3042\u3055\u306F <u>\u304A\u3061\u3083</u>\u3092 \u306E\u3080\u3002\r\n\u3042\u3064\u3044
      <u>\u304A\u3061\u3083</u>\u3002"
    correctItemId: Te
    narrationClip: {fileID: 8300000, guid: 884752b4a2c889f4292a43b15f78b8da, type: 3}
  - bodyText: "\u306A\u3064\u306B <u>\u30A2\u30A4\u30B9\u30AF\u30EA\u30FC\u30E0</u>\u3092
      \u305F\u3079\u308B\u3002\r\n\u3064\u3081\u305F\u3044 <u>\u30A2\u30A4\u30B9\u30AF\u30EA\u30FC\u30E0</u>!"
